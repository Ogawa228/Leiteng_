{
    "manifest_version": 3,
    "name": "Show Tabs in Fullscreen",
    "version": "1.0",
    "description": "Automatically show tabs and toolbar in fullscreen mode",
    "permissions": [
      "activeTab",
      "tabs",
      "storage"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["styles.css"],
        "run_at": "document_end"
      }
    ],
    "icons": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
  